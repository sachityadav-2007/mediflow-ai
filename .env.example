# =============================================================================
# MediFlow AI 2.0 — Master Environment Configuration Template
# =============================================================================

# --- Backend Server Configuration (Node.js Express) ---
PORT=5001
NODE_ENV=development

# --- CORS & Client Origin ---
CLIENT_URL=http://localhost:5173

# --- PostgreSQL Database Connection ---
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/mediflow_ai?schema=public"

# --- Authentication & Session Security ---
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_in_production
JWT_EXPIRES_IN=7d

# --- Python FastAPI ML Microservice (Port 5002) ---
ML_SERVICE_URL=http://localhost:5002
ML_SERVICE_PORT=5002
ML_SERVICE_SECRET=replace_with_internal_secret_token_min_32_chars

# --- Email Notifications (Nodemailer / SMTP) ---
# If left blank, MediFlow AI automatically provisions an Ethereal development inbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MediFlow AI Central Hospital <notifications@mediflow.com>"

# --- Frontend Client Configuration ---
VITE_API_URL=http://localhost:5001
