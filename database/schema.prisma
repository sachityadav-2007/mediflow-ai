// Prisma schema for MediFlow AI - Smart Hospital Appointment & Doctor Availability System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  ADMIN
  DOCTOR
  PATIENT
  RECEPTIONIST
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum PresenceStatus {
  PRESENT
  AWAY
  BUSY
  OFFLINE
  AVAILABLE
  IN_CONSULTATION
  ON_BREAK
  ON_LEAVE
}

enum DetectionMethod {
  MANUAL
  RFID
  FACE_RECOGNITION
  MOBILE_PROXIMITY
  QR_SCAN
}

enum AttendanceStatus {
  CHECKED_IN
  CHECKED_OUT
  AUTO_CLOSED
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  CANCELLED
  BLOCKED
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum WaitlistStatus {
  PENDING
  NOTIFIED
  ALLOCATED
  EXPIRED
  CANCELLED
}

// -----------------------------------------------------------------------------
// MODEL 1: USER
// Central authentication and profile record
// -----------------------------------------------------------------------------
model User {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  password       String
  role           Role      @default(PATIENT)
  phone          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // 1-to-1 profile relations
  doctorProfile  Doctor?
  patientProfile Patient?

  @@map("users")
}

// -----------------------------------------------------------------------------
// MODEL 2: DOCTOR
// Doctor-specific profile with professional credentials
// -----------------------------------------------------------------------------
model Doctor {
  id                   String               @id @default(uuid())
  userId               String               @unique
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization       String
  department           String
  experience           Int                  // Years of clinical experience
  qualification        String
  consultationFee      Float
  consultationDuration Int                  @default(30) // Consultation duration in minutes
  currentPresence      PresenceStatus       @default(OFFLINE) // Current live presence status
  roomNumber           String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  // Relationships
  availabilities       DoctorAvailability[]
  presenceLogs         PresenceLog[]
  appointmentSlots     AppointmentSlot[]
  appointments         Appointment[]
  waitlists            Waitlist[]
  predictionLogs       PredictionLog[]
  attendances          DoctorAttendance[]

  @@map("doctors")
}

// -----------------------------------------------------------------------------
// MODEL 3: PATIENT
// Patient-specific medical and emergency profile
// -----------------------------------------------------------------------------
model Patient {
  id               String        @id @default(uuid())
  userId           String        @unique
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth      DateTime?
  gender           Gender?
  bloodGroup       String?
  address          String?
  emergencyContact String?
  medicalHistory   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relationships
  appointments     Appointment[]
  waitlists        Waitlist[]
  triageHistories  TriageHistory[]

  @@map("patients")
}

// -----------------------------------------------------------------------------
// MODEL 4: DOCTOR AVAILABILITY
// Real-time presence tracking and recurring working schedule
// -----------------------------------------------------------------------------
model DoctorAvailability {
  id             String         @id @default(uuid())
  doctorId       String
  doctor         Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek      DayOfWeek
  startTime      String         // e.g. "09:00"
  endTime        String         // e.g. "17:00"
  isAvailable    Boolean        @default(true)
  presenceStatus PresenceStatus @default(AVAILABLE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("doctor_availabilities")
}

// -----------------------------------------------------------------------------
// MODEL 5: PRESENCE LOG
// Historical audit log of doctor status transitions
// -----------------------------------------------------------------------------
model PresenceLog {
  id              String          @id @default(uuid())
  doctorId        String
  doctor          Doctor          @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  status          PresenceStatus
  detectionMethod DetectionMethod @default(MANUAL)
  notes           String?
  timestamp       DateTime        @default(now())

  @@map("presence_logs")
}

// -----------------------------------------------------------------------------
// MODEL 6: APPOINTMENT SLOT
// Discrete bookable time slots generated for doctors
// -----------------------------------------------------------------------------
model AppointmentSlot {
  id          String       @id @default(uuid())
  doctorId    String
  doctor      Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  slotDate    DateTime     // Specific date for this slot
  startTime   String       // e.g. "09:00"
  endTime     String       // e.g. "09:30"
  status      SlotStatus   @default(AVAILABLE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // 1-to-1 relation with an appointment
  appointment Appointment?

  @@map("appointment_slots")
}

// -----------------------------------------------------------------------------
// MODEL 7: APPOINTMENT
// Patient booking record with smart priority allocation
// -----------------------------------------------------------------------------
model Appointment {
  id                String            @id @default(uuid())
  appointmentNumber String            @unique // e.g. "APT-20261031-001"
  patientId         String
  patient           Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId          String
  doctor            Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  slotId            String            @unique
  slot              AppointmentSlot   @relation(fields: [slotId], references: [id], onDelete: Cascade)
  appointmentDate   DateTime
  priority          PriorityLevel     @default(MEDIUM)
  status            AppointmentStatus @default(SCHEDULED)
  reason            String?
  notes             String?
  checkInToken            String?           @unique
  checkedInAt             DateTime?
  consultationStartedAt   DateTime?
  consultationCompletedAt DateTime?
  actualDurationMinutes   Int?
  reminderSentAt          DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("appointments")
}

// -----------------------------------------------------------------------------
// MODEL 8: WAITLIST
// Dynamic patient waitlist with priority score for automated allocation
// -----------------------------------------------------------------------------
model Waitlist {
  id            String         @id @default(uuid())
  patientId     String
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  preferredDate DateTime
  priority      PriorityLevel  @default(MEDIUM) // Medical Priority
  urgency       PriorityLevel  @default(MEDIUM) // Clinical Urgency
  priorityScore Int            @default(0) // Higher score = higher priority
  status        WaitlistStatus @default(PENDING)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("waitlists")
}

// -----------------------------------------------------------------------------
// MODEL 9: PREDICTION LOG
// Audit & tracking of AI forecasts, demand estimations, and slot recommendations
// -----------------------------------------------------------------------------
model PredictionLog {
  id               String    @id @default(uuid())
  predictionType   String    // "AVAILABILITY" | "DEMAND" | "WAITING_TIME" | "SLOT_RECOMMENDATION"
  doctorId         String?
  doctor           Doctor?   @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  department       String?
  targetDate       DateTime?
  forecastPeriod   String?   // e.g. "NEXT_7_DAYS", "DAY_SPECIFIC"
  predictionResult Json      // Detailed output payload and breakdown
  confidenceScore  Float?    // 0.0 - 1.0
  algorithmVersion String    @default("v1.0-statistical-baseline")
  isCached         Boolean   @default(false)
  createdAt        DateTime  @default(now())

  @@index([predictionType, doctorId])
  @@index([predictionType, department])
  @@index([createdAt])
  @@map("prediction_logs")
}

// -----------------------------------------------------------------------------
// MODEL 10: HOSPITAL QR CODE (Phase 12: Doctor QR Attendance)
// Dynamic short-lived cryptographic check-in QR codes for hospital locations
// -----------------------------------------------------------------------------
model HospitalQRCode {
  id              String             @id @default(uuid())
  code            String             @unique // Unique cryptographic code identifier
  signedToken     String             // Cryptographically signed JWT token
  location        String             // Hospital building/wing/suite e.g. "Main OPD Building - Ground Floor"
  validityMinutes Int                @default(60)
  expiresAt       DateTime
  isActive        Boolean            @default(true)
  revokedAt       DateTime?
  revokedBy       String?            // Admin user ID who revoked the code
  createdById     String             // Admin user ID who created the code
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  scanEvents      QRScanAudit[]
  attendances     DoctorAttendance[]

  @@index([code])
  @@index([isActive, expiresAt])
  @@map("hospital_qr_codes")
}

// -----------------------------------------------------------------------------
// MODEL 11: DOCTOR ATTENDANCE RECORD
// Tracks doctor check-in, check-out sessions, durations, and locations
// -----------------------------------------------------------------------------
model DoctorAttendance {
  id              String           @id @default(uuid())
  doctorId        String
  doctor          Doctor           @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  qrCodeId        String?
  qrCode          HospitalQRCode?  @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  location        String           // Location where doctor checked in
  checkInTime     DateTime         @default(now())
  checkOutTime    DateTime?
  durationMinutes Int?             // Computed working minutes upon check-out
  status          AttendanceStatus @default(CHECKED_IN)
  checkInMethod   DetectionMethod  @default(QR_SCAN)
  checkOutMethod  DetectionMethod?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([doctorId, checkInTime])
  @@index([status])
  @@map("doctor_attendances")
}

// -----------------------------------------------------------------------------
// MODEL 12: QR SCAN AUDIT EVENT
// Security & audit trail for all QR scan interactions (valid, rejected, expired)
// -----------------------------------------------------------------------------
model QRScanAudit {
  id            String          @id @default(uuid())
  qrCodeId      String?
  qrCode        HospitalQRCode? @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  userId        String
  userRole      Role
  doctorId      String?
  doctorName    String?
  location      String
  action        String          // "CHECK_IN" | "CHECK_OUT" | "INVALID_SCAN"
  status        String          // "SUCCESS" | "FAILED" | "REPLAY_REJECTED" | "EXPIRED" | "REVOKED"
  ipAddress     String?
  userAgent     String?
  failureReason String?
  timestamp     DateTime        @default(now())

  @@index([qrCodeId])
  @@index([doctorId])
  @@index([timestamp])
  @@map("qr_scan_audits")
}

// -----------------------------------------------------------------------------
// MODEL 13: TRIAGE HISTORY (AI Health Assistant & Smart Symptom Triage)
// Stores patient symptom evaluations, department guidance, and urgency records
// -----------------------------------------------------------------------------
model TriageHistory {
  id                    String        @id @default(uuid())
  patientId             String
  patient               Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  symptoms              String        @db.Text
  duration              String?       // e.g. "1-3 days", "< 24 hours"
  severity              String?       // "Mild" | "Moderate" | "Severe"
  recommendedDepartment String
  specialistType        String
  urgency               String        // "Routine" | "Soon" | "Urgent" | "Emergency"
  confidence            Float         // e.g. 75.0 (%)
  guidance              String?       @db.Text
  matchedSymptoms       String[]      @default([])
  isEmergency           Boolean       @default(false)
  createdAt             DateTime      @default(now())

  @@index([patientId, createdAt])
  @@map("triage_histories")
}
