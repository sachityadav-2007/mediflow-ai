# =============================================================================
# MediFlow AI 2.0 — Python FastAPI ML Microservice Configuration
# =============================================================================

# Service Port
ML_SERVICE_PORT=5002

# Debug Mode
DEBUG=false

# Pre-shared internal token for authenticated Express <-> FastAPI communication
ML_SERVICE_SECRET=replace_with_internal_secret_token_min_32_chars

# Read-only Database URL for prospective training pipelines
DATABASE_URL="postgresql://postgres:password@localhost:5432/mediflow_ai?schema=public"

