// Prisma schema for MediFlow AI - Smart Hospital Appointment & Doctor Availability System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  ADMIN
  DOCTOR
  PATIENT
  RECEPTIONIST
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum PresenceStatus {
  PRESENT
  AWAY
  BUSY
  OFFLINE
  AVAILABLE
  IN_CONSULTATION
  ON_BREAK
  ON_LEAVE
}

enum DetectionMethod {
  MANUAL
  RFID
  FACE_RECOGNITION
  MOBILE_PROXIMITY
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  CANCELLED
  BLOCKED
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum WaitlistStatus {
  PENDING
  NOTIFIED
  ALLOCATED
  EXPIRED
  CANCELLED
}

// -----------------------------------------------------------------------------
// MODEL 1: USER
// Central authentication and profile record
// -----------------------------------------------------------------------------
model User {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  password       String
  role           Role      @default(PATIENT)
  phone          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // 1-to-1 profile relations
  doctorProfile  Doctor?
  patientProfile Patient?

  @@map("users")
}

// -----------------------------------------------------------------------------
// MODEL 2: DOCTOR
// Doctor-specific profile with professional credentials
// -----------------------------------------------------------------------------
model Doctor {
  id                   String               @id @default(uuid())
  userId               String               @unique
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization       String
  department           String
  experience           Int                  // Years of clinical experience
  qualification        String
  consultationFee      Float
  consultationDuration Int                  @default(30) // Consultation duration in minutes
  currentPresence      PresenceStatus       @default(OFFLINE) // Current live presence status
  roomNumber           String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  // Relationships
  availabilities       DoctorAvailability[]
  presenceLogs         PresenceLog[]
  appointmentSlots     AppointmentSlot[]
  appointments         Appointment[]
  waitlists            Waitlist[]

  @@map("doctors")
}

// -----------------------------------------------------------------------------
// MODEL 3: PATIENT
// Patient-specific medical and emergency profile
// -----------------------------------------------------------------------------
model Patient {
  id               String        @id @default(uuid())
  userId           String        @unique
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth      DateTime?
  gender           Gender?
  bloodGroup       String?
  address          String?
  emergencyContact String?
  medicalHistory   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relationships
  appointments     Appointment[]
  waitlists        Waitlist[]

  @@map("patients")
}

// -----------------------------------------------------------------------------
// MODEL 4: DOCTOR AVAILABILITY
// Real-time presence tracking and recurring working schedule
// -----------------------------------------------------------------------------
model DoctorAvailability {
  id             String         @id @default(uuid())
  doctorId       String
  doctor         Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek      DayOfWeek
  startTime      String         // e.g. "09:00"
  endTime        String         // e.g. "17:00"
  isAvailable    Boolean        @default(true)
  presenceStatus PresenceStatus @default(AVAILABLE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("doctor_availabilities")
}

// -----------------------------------------------------------------------------
// MODEL 5: PRESENCE LOG
// Historical audit log of doctor status transitions
// -----------------------------------------------------------------------------
model PresenceLog {
  id              String          @id @default(uuid())
  doctorId        String
  doctor          Doctor          @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  status          PresenceStatus
  detectionMethod DetectionMethod @default(MANUAL)
  notes           String?
  timestamp       DateTime        @default(now())

  @@map("presence_logs")
}

// -----------------------------------------------------------------------------
// MODEL 6: APPOINTMENT SLOT
// Discrete bookable time slots generated for doctors
// -----------------------------------------------------------------------------
model AppointmentSlot {
  id          String       @id @default(uuid())
  doctorId    String
  doctor      Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  slotDate    DateTime     // Specific date for this slot
  startTime   String       // e.g. "09:00"
  endTime     String       // e.g. "09:30"
  status      SlotStatus   @default(AVAILABLE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // 1-to-1 relation with an appointment
  appointment Appointment?

  @@map("appointment_slots")
}

// -----------------------------------------------------------------------------
// MODEL 7: APPOINTMENT
// Patient booking record with smart priority allocation
// -----------------------------------------------------------------------------
model Appointment {
  id                String            @id @default(uuid())
  appointmentNumber String            @unique // e.g. "APT-20261031-001"
  patientId         String
  patient           Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId          String
  doctor            Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  slotId            String            @unique
  slot              AppointmentSlot   @relation(fields: [slotId], references: [id], onDelete: Cascade)
  appointmentDate   DateTime
  priority          PriorityLevel     @default(MEDIUM)
  status            AppointmentStatus @default(SCHEDULED)
  reason            String?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("appointments")
}

// -----------------------------------------------------------------------------
// MODEL 8: WAITLIST
// Dynamic patient waitlist with priority score for automated allocation
// -----------------------------------------------------------------------------
model Waitlist {
  id            String         @id @default(uuid())
  patientId     String
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  preferredDate DateTime
  priority      PriorityLevel  @default(MEDIUM)
  priorityScore Int            @default(0) // Higher score = higher priority
  status        WaitlistStatus @default(PENDING)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("waitlists")
}
